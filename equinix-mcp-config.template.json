{
  "mcpServers": {
    "equinix": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/equinix-labs/equinix-docs-mcp-server",
        "equinix-docs-mcp-server"
      ],
      "env": {
        "EQUINIX_CLIENT_ID": "YOUR_EQUINIX_CLIENT_ID",
        "EQUINIX_CLIENT_SECRET": "YOUR_EQUINIX_CLIENT_SECRET"
      }
    }
  }
}
